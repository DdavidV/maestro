<Layouts.app flash={@flash} workspace={@workspace}>
  <:drawer>
    <.workspace_drawer
      workspace={@workspace}
      current_kind={@current_kind}
      current_path={@current_path}
    />
  </:drawer>

  <:breadcrumbs>
    <.breadcrumbs :if={@live_action == :dashboard} workspace={@workspace} crumbs={[]} />
    <.resource_breadcrumbs
      :if={@live_action in [:index, :show]}
      workspace={@workspace}
      kind={@kind}
      segment={@segment}
      path={@current_path}
      live_action={@live_action}
    />
  </:breadcrumbs>

  <div :if={@live_action == :dashboard}>
    <.header>
      {@workspace.name}
      <:subtitle>{@workspace.root_dir}</:subtitle>
    </.header>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <.link
        :for={{kind, label, path} <- resource_tiles()}
        patch={"/workspace/#{@workspace.id}/#{path}"}
        class="card bg-base-200 hover:bg-base-300 transition p-6 text-center"
      >
        <div class="text-3xl font-bold">{@counts[kind]}</div>
        <div class="text-sm text-base-content/70 mt-1">{label}</div>
      </.link>
    </div>
  </div>

  <div :if={@live_action == :index} class="flex flex-col" style="height: calc(100vh - 12rem)">
    <.header>
      {kind_label(@kind)}
      <:subtitle>{@workspace.name}</:subtitle>
      <:actions>
        <.button patch={"/workspace/#{@workspace.id}/#{@segment}/new"} variant="primary">
          New {kind_label(@kind)}
        </.button>
      </:actions>
    </.header>

    <form id="search-form" phx-change="search" class="mb-4 max-w-sm shrink-0">
      <input
        type="text"
        name="query"
        value={@query}
        placeholder="Search by path..."
        class="input w-full"
        phx-debounce="200"
      />
    </form>

    <div class="flex-1 min-h-0 overflow-y-auto">
      <.table id={@segment} rows={@streams.entries} row_item={fn {_id, entry} -> entry end}>
        <:col :let={entry} label="Path">
          <.link
            patch={"/workspace/#{@workspace.id}/#{@segment}/#{entry.path}"}
            class="link link-hover font-mono"
          >
            {entry.path}
          </.link>
        </:col>
        <:col :let={entry} label="Name">{entry.name}</:col>
        <:col :let={entry} label="Description">{entry.description}</:col>
        <:col :let={entry} :if={@kind == :suite} label="Tags">
          <.kind_badge :for={tag <- entry.tags} label={tag} />
        </:col>
      </.table>

      <p :if={@total == 0} class="text-base-content/70">No {kind_label(@kind)} found.</p>
    </div>

    <div :if={@total > @page_size} class="flex items-center gap-2 mt-4 shrink-0">
      <.button disabled={@page <= 1} phx-click="paginate" phx-value-page={@page - 1}>
        Previous
      </.button>
      <span class="text-sm text-base-content/70">
        Page {@page} of {ceil(@total / @page_size)} ({@total} total)
      </span>
      <.button
        disabled={@page * @page_size >= @total}
        phx-click="paginate"
        phx-value-page={@page + 1}
      >
        Next
      </.button>
    </div>
  </div>

  <div :if={@live_action == :show} class="flex flex-col" style="height: calc(100vh - 12rem)">
    <.header>
      {@resource["name"] || @path}
      <:subtitle><span class="font-mono">{@path}</span></:subtitle>
      <:actions>
        <.button :if={!@error && @kind in [:suite, :test_plan]} phx-click="run" variant="primary">
          Run
        </.button>
        <.button
          :if={!@error}
          patch={"/workspace/#{@workspace.id}/#{@segment}/edit/#{@path}"}
          variant="primary"
        >
          Edit
        </.button>
        <.button
          :if={!@error}
          phx-click="delete"
          data-confirm={"Delete #{@path}? This cannot be undone."}
        >
          Delete
        </.button>
      </:actions>
    </.header>

    <div class="flex-1 min-h-0 overflow-y-auto">
      <div :if={@error} class="alert alert-error">
        Could not load this {@kind |> Atom.to_string() |> String.replace("_", " ")}: {inspect(
          @error
        )}
      </div>

      <div :if={@resource && @kind == :suite}>
        <p :if={@resource["description"]} class="mb-4 text-base-content/70">
          {@resource["description"]}
        </p>

        <div class="mb-4">
          <.kind_badge :for={tag <- @resource["tags"] || []} label={tag} />
        </div>

        <h3 class="font-semibold mb-2">Testcases</h3>
        <div
          :for={testcase <- @resource["testcases"]}
          class="card bg-base-100 border border-base-300 p-4 mb-4"
        >
          <div class="font-semibold mb-1">{testcase["name"] || testcase["id"]}</div>
          <div class="text-xs font-mono text-base-content/50 mb-2">{testcase["id"]}</div>
          <p :if={testcase["description"]} class="text-sm text-base-content/70 mb-2">
            {testcase["description"]}
          </p>

          <.step_card
            :for={{step, i} <- Enum.with_index(testcase["steps"])}
            step={step}
            index={i}
          />
        </div>
      </div>

      <div :if={@resource && @kind == :scenario}>
        <p :if={@resource["description"]} class="mb-4 text-base-content/70">
          {@resource["description"]}
        </p>

        <div :if={default_dataset = @resource["default_dataset"]} class="mb-4">
          <h3 class="font-semibold mb-2">Default dataset</h3>
          <span :if={is_binary(default_dataset)} class="font-mono">{default_dataset}</span>
          <.dataset_body :if={is_map(default_dataset)} dataset={default_dataset} />
        </div>

        <h3 class="font-semibold mb-2">Steps</h3>
        <.step_card :for={{step, i} <- Enum.with_index(@resource["steps"])} step={step} index={i} />
      </div>

      <div :if={@resource && @kind == :dataset}>
        <p :if={@resource["description"]} class="mb-4 text-base-content/70">
          {@resource["description"]}
        </p>
        <.dataset_body dataset={@resource} />
      </div>

      <div :if={@resource && @kind == :template}>
        <p :if={@resource["description"]} class="mb-4 text-base-content/70">
          {@resource["description"]}
        </p>

        <h3 class="font-semibold mb-1">Clients</h3>
        <div class="mb-4">
          <.kind_badge :for={client <- @resource["clients"] || []} label={client} />
        </div>

        <h3 class="font-semibold mb-1">Payload</h3>
        <pre class="bg-base-200 rounded p-3 text-sm overflow-x-auto mb-4">{Jason.encode!(@resource["payload"], pretty: true)}</pre>

        <div :if={@resource["options"]}>
          <h3 class="font-semibold mb-1">Options</h3>
          <pre class="bg-base-200 rounded p-3 text-sm overflow-x-auto">{Jason.encode!(@resource["options"], pretty: true)}</pre>
        </div>
      </div>

      <div :if={@resource && @kind == :test_plan}>
        <p :if={@resource["description"]} class="mb-4 text-base-content/70">
          {@resource["description"]}
        </p>

        <h3 class="font-semibold mb-2">Suites</h3>
        <ul class="list">
          <li :for={suite_path <- @resource["test_suites"]} class="list-row">
            <.link
              patch={"/workspace/#{@workspace.id}/suites/#{suite_path}"}
              class="link link-hover font-mono"
            >
              {suite_path}
            </.link>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layouts.app>
