<Layouts.app flash={@flash} workspace={@workspace} active={:history}>
  <:drawer>
    <.workspace_drawer workspace={@workspace} />
  </:drawer>

  <:breadcrumbs>
    <.breadcrumbs
      workspace={@workspace}
      crumbs={[
        {"History", "/workspace/#{@workspace.id}/history"},
        {@run_id, "/workspace/#{@workspace.id}/history/#{@run_id}"},
        {"Report", nil}
      ]}
    />
  </:breadcrumbs>

  <.header>
    Report
    <:eyebrow>
      <.icon name="hero-document-chart-bar-mini" class="size-3.5" />
      <span class="font-mono">{@run_id}</span>
    </:eyebrow>
    <:subtitle>Every suite, testcase, step and assertion in this run.</:subtitle>
    <:actions>
      <div id="report-formats" class="dropdown dropdown-end">
        <div
          tabindex="0"
          role="button"
          class="btn btn-sm gap-1.5 border-base-300 bg-base-100 font-medium shadow-xs hover:bg-base-200"
        >
          <.icon name="hero-arrow-down-tray-mini" class="size-4" /> Download
          <.icon name="hero-chevron-down-mini" class="size-4 text-base-content/50" />
        </div>
        <ul
          tabindex="0"
          class="dropdown-content z-30 mt-1 w-60 rounded-box border border-base-300 bg-base-100 p-1 shadow-lg"
        >
          <li class="section-label px-2.5 pt-1.5 pb-1">Download as</li>
          <li :for={format <- @download_formats}>
            <a
              href={"/workspace/#{@workspace.id}/reports/#{@run_id}/download#{format.query}"}
              class="flex items-center gap-2 rounded-field px-2.5 py-1.5 text-sm hover:bg-base-200"
            >
              <.icon name="hero-arrow-down-tray-mini" class="size-4 text-base-content/40" />
              <span class="flex-1 truncate">{format.label}</span>
              <span class="font-mono text-xs text-base-content/40">.{format.extension}</span>
            </a>
          </li>
        </ul>
      </div>
    </:actions>
  </.header>

  <div class="space-y-2">
    <.report_header model={@model} />
  </div>

  <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-[minmax(0,1fr)_15rem]">
    <div class="space-y-4">
      <.report_suite :for={suite <- @model.suites} suite={suite} />

      <div
        :if={@model.suites == []}
        class="panel px-6 py-12 text-center text-sm text-base-content/60"
      >
        This run has no suites.
      </div>
    </div>

    <div :if={@model.suites != []} class="hidden lg:sticky lg:top-0 lg:block">
      <.report_toc suites={@model.suites} />
    </div>
  </div>
</Layouts.app>
