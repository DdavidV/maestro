<Layouts.app flash={@flash} workspace={@workspace}>
  <:drawer>
    <.workspace_drawer workspace={@workspace} />
  </:drawer>

  <:breadcrumbs>
    <.breadcrumbs workspace={@workspace} crumbs={[{"Run", nil}]} />
  </:breadcrumbs>

  <.header>
    Run
    <:subtitle>{@workspace.name}</:subtitle>
    <:actions>
      <.button phx-click="run-selected" variant="primary" disabled={MapSet.size(@selected) == 0}>
        Run selected ({MapSet.size(@selected)})
      </.button>
    </:actions>
  </.header>

  <div :if={MapSet.size(@selected) > 0} class="card bg-base-200 p-4 mb-4 shrink-0">
    <div class="flex items-center justify-between mb-2">
      <h3 class="font-semibold text-sm">Selected ({MapSet.size(@selected)})</h3>
      <.button phx-click="clear-selected">Clear</.button>
    </div>
    <ul class="flex flex-wrap gap-2">
      <li :for={{kind, path} <- @selected}>
        <button
          type="button"
          phx-click="toggle-selected"
          phx-value-kind={kind}
          phx-value-path={path}
          class="badge badge-soft gap-1"
        >
          <span class="text-xs opacity-70">{kind}</span>
          <span class="font-mono">{path}</span>
          <.icon name="hero-x-mark" class="size-3" />
        </button>
      </li>
    </ul>
  </div>

  <div
    class="grid grid-cols-1 lg:grid-cols-2 gap-6 flex-1 min-h-0"
    style="height: calc(100vh - 20rem)"
  >
    <div class="card bg-base-100 border border-base-300 flex flex-col min-h-0">
      <div class="p-4 pb-2 shrink-0">
        <h3 class="font-semibold mb-2">Suites</h3>
        <form id="suite-search-form" phx-change="search-suite">
          <input
            type="text"
            name="query"
            value={@suite_query}
            placeholder="Search suites by path..."
            class="input input-sm w-full"
            phx-debounce="200"
          />
        </form>
      </div>

      <div class="flex-1 min-h-0 overflow-y-auto px-4">
        <ul class="menu p-0 gap-0.5">
          <li :for={path <- @suite_paths}>
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                checked={MapSet.member?(@selected, {:suite, path})}
                phx-click="toggle-selected"
                phx-value-kind="suite"
                phx-value-path={path}
                class="checkbox checkbox-sm"
              />
              <span class="font-mono text-sm">{path}</span>
            </label>
          </li>
          <li :if={@suite_paths == []}>
            <span class="text-sm text-base-content/70">No suites found.</span>
          </li>
        </ul>
      </div>

      <div class="flex items-center gap-2 p-4 pt-2 border-t border-base-300 shrink-0">
        <.button
          disabled={@suite_page <= 1}
          phx-click="paginate-suite"
          phx-value-page={@suite_page - 1}
        >
          Previous
        </.button>
        <span class="text-sm text-base-content/70">
          Page {@suite_page} of {max(ceil(@suite_total / @suite_page_size), 1)} ({@suite_total} total)
        </span>
        <.button
          disabled={@suite_page * @suite_page_size >= @suite_total}
          phx-click="paginate-suite"
          phx-value-page={@suite_page + 1}
        >
          Next
        </.button>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-300 flex flex-col min-h-0">
      <div class="p-4 pb-2 shrink-0">
        <h3 class="font-semibold mb-2">Test Plans</h3>
        <form id="test_plan-search-form" phx-change="search-test_plan">
          <input
            type="text"
            name="query"
            value={@test_plan_query}
            placeholder="Search test plans by path..."
            class="input input-sm w-full"
            phx-debounce="200"
          />
        </form>
      </div>

      <div class="flex-1 min-h-0 overflow-y-auto px-4">
        <ul class="menu p-0 gap-0.5">
          <li :for={path <- @test_plan_paths}>
            <label class="flex items-center gap-2 cursor-pointer">
              <input
                type="checkbox"
                checked={MapSet.member?(@selected, {:test_plan, path})}
                phx-click="toggle-selected"
                phx-value-kind="test_plan"
                phx-value-path={path}
                class="checkbox checkbox-sm"
              />
              <span class="font-mono text-sm">{path}</span>
            </label>
          </li>
          <li :if={@test_plan_paths == []}>
            <span class="text-sm text-base-content/70">No test plans found.</span>
          </li>
        </ul>
      </div>

      <div class="flex items-center gap-2 p-4 pt-2 border-t border-base-300 shrink-0">
        <.button
          disabled={@test_plan_page <= 1}
          phx-click="paginate-test_plan"
          phx-value-page={@test_plan_page - 1}
        >
          Previous
        </.button>
        <span class="text-sm text-base-content/70">
          Page {@test_plan_page} of {max(ceil(@test_plan_total / @test_plan_page_size), 1)} ({@test_plan_total} total)
        </span>
        <.button
          disabled={@test_plan_page * @test_plan_page_size >= @test_plan_total}
          phx-click="paginate-test_plan"
          phx-value-page={@test_plan_page + 1}
        >
          Next
        </.button>
      </div>
    </div>
  </div>
</Layouts.app>
