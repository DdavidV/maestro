<Layouts.app flash={@flash} workspace={@workspace} active={:run}>
  <:drawer>
    <.workspace_drawer workspace={@workspace} />
  </:drawer>

  <:breadcrumbs>
    <.breadcrumbs workspace={@workspace} crumbs={[{"Run", nil}]} />
  </:breadcrumbs>

  <.header>
    Start a run
    <:subtitle>
      Pick any mix of suites and test plans. They run together as a single run.
    </:subtitle>
  </.header>

  <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
    <div class="space-y-6 lg:col-span-2">
      <.picker_section
        kind={:suite}
        title="Suites"
        query={@suite_query}
        paths={@suite_paths}
        page={@suite_page}
        total={@suite_total}
        page_size={@suite_page_size}
        selected={@selected}
      />
      <.picker_section
        kind={:test_plan}
        title="Test Plans"
        query={@test_plan_query}
        paths={@test_plan_paths}
        page={@test_plan_page}
        total={@test_plan_total}
        page_size={@test_plan_page_size}
        selected={@selected}
      />
    </div>

    <aside class="panel overflow-hidden lg:sticky lg:top-0">
      <div class="panel-header">
        <h3 class="text-sm font-semibold">Selected ({MapSet.size(@selected)})</h3>
        <.button
          :if={MapSet.size(@selected) > 0}
          variant="ghost"
          size="xs"
          phx-click="clear-selected"
        >
          Clear
        </.button>
      </div>

      <ul :if={MapSet.size(@selected) > 0} class="max-h-80 space-y-1 overflow-y-auto p-2">
        <li :for={{kind, path} <- @selected}>
          <div class="group flex items-center gap-2 rounded-field px-2 py-1.5 hover:bg-base-200">
            <.icon name={kind_icon(kind)} class="size-4 shrink-0 text-base-content/40" />
            <span class="min-w-0 flex-1">
              <span class="block truncate kbd-path">{path}</span>
              <span class="block text-[0.6875rem] text-base-content/50">
                {kind_singular(kind)}
              </span>
            </span>
            <button
              type="button"
              phx-click="toggle-selected"
              phx-value-kind={kind}
              phx-value-path={path}
              class="btn btn-ghost btn-xs btn-square text-base-content/40 hover:text-base-content"
              aria-label={"Remove #{path}"}
            >
              <.icon name="hero-x-mark-mini" class="size-4" />
            </button>
          </div>
        </li>
      </ul>

      <div
        :if={MapSet.size(@selected) == 0}
        class="flex flex-col items-center gap-2 px-6 py-8 text-center"
      >
        <span class="grid size-9 place-items-center rounded-full bg-base-200 text-base-content/40">
          <.icon name="hero-check-circle" class="size-5" />
        </span>
        <p class="text-sm text-base-content/60">
          Tick suites or test plans to add them to this run.
        </p>
      </div>

      <div class="border-t border-base-300 p-3">
        <.button
          phx-click="run-selected"
          variant="primary"
          size="md"
          class="w-full"
          disabled={MapSet.size(@selected) == 0}
        >
          <.icon name="hero-play-mini" class="size-4" /> Run selected ({MapSet.size(@selected)})
        </.button>
      </div>
    </aside>
  </div>
</Layouts.app>
