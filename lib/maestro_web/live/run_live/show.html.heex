<Layouts.app flash={@flash} workspace={@workspace} active={:history}>
  <:drawer>
    <.workspace_drawer workspace={@workspace} />
  </:drawer>

  <:breadcrumbs>
    <.breadcrumbs
      workspace={@workspace}
      crumbs={[
        {"History", "/workspace/#{@workspace.id}/history"},
        {@run_id, nil}
      ]}
    />
  </:breadcrumbs>

  <.header>
    <span class="font-mono text-xl">{@run_id}</span>
    <:eyebrow>
      <.icon name="hero-play-mini" class="size-3.5" /> Run
      <.status_badge status={@run_result.status} class="ml-1" />
    </:eyebrow>
    <:subtitle>
      {length(@run_result.suites)} {if length(@run_result.suites) == 1,
        do: "suite",
        else: "suites"} · live progress updates automatically
    </:subtitle>
    <:actions>
      <.button navigate={"/workspace/#{@workspace.id}/reports/#{@run_id}"} variant="primary">
        <.icon name="hero-document-chart-bar-mini" class="size-4" /> View report
      </.button>
    </:actions>
  </.header>

  <.run_summary :if={@run_result.suites != []} suites={@run_result.suites} />

  <div class="space-y-4">
    <.suite_card :for={suite <- @run_result.suites} suite={suite} />
  </div>

  <div
    :if={@run_result.suites == []}
    class="panel px-6 py-12 text-center text-sm text-base-content/60"
  >
    This run has no suites.
  </div>
</Layouts.app>
